FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# System deps for Next/sharp on Alpine
RUN apk add --no-cache libc6-compat

# Install dependencies (faster, quieter)
RUN npm ci --no-audit --no-fund

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Start development server
CMD ["npm", "run", "dev"] 