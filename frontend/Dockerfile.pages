# Local preview of the GitHub Pages build: static export served by nginx under
# /NCEA-2-ATAR/, the same URL layout as https://<user>.github.io/NCEA-2-ATAR/.
# Used by docker-compose.pages.yml.

FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ENV NEXT_PUBLIC_BASE_PATH=/NCEA-2-ATAR \
    NEXT_PUBLIC_SITE_URL=http://localhost:8080/NCEA-2-ATAR
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.pages.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/out /usr/share/nginx/html/NCEA-2-ATAR
EXPOSE 80
